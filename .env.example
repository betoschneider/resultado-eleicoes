# ==============================================================================
# Configurações da API do Tribunal Superior Eleitoral (TSE) - Eleições 2026
# Ambiente Oficial de Produção do TSE
# ==============================================================================
TSE_BASE_URL=https://resultados.tse.jus.br/oficial
TSE_AMBIENTE=
TSE_CICLO=ele2026
TURNO=1

# Código oficial atribuído pelo TSE para a apuração presidencial de 2026
TSE_COD_ELEICAO_1T=21270
TSE_COD_ELEICAO_2T=21271

# Código do cargo no TSE (c0001 = Presidente da República)
TSE_COD_CARGO=c0001

# Modo de simulação local artificial (false = consulta diretamente a API oficial do TSE)
TSE_SIMULATE=false

# Intervalo entre consultas do worker em segundos
POLL_INTERVAL_SECONDS=60

# ==============================================================================
# Configurações do Servidor Streamlit
# ==============================================================================
STREAMLIT_SERVER_PORT=8540
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ==============================================================================
# Persistência de Dados
# ==============================================================================
ELEICOES_DB_PATH=data/eleicoes.db
ELEICOES_CSV_PATH=resultado.csv
